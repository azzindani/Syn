# Syn deployment config — copy to `.env` and fill in. `.env` is gitignored.
# Real shell exports always win over this file, so a one-off
# `set SYN_API_KEY=...` overrides the value here without editing it.
# The key is read at send time by the provider only: never logged, never
# written to the journal, never placed in a prompt or an event.

# --- provider -------------------------------------------------------------
# OpenRouter key: https://openrouter.ai/keys  (starts sk-or-v1-)
SYN_API_KEY=

# Endpoint. Any OpenAI-compatible /chat/completions host works.
SYN_BASE_URL=https://openrouter.ai/api/v1

# --- model selection ------------------------------------------------------
# Four router slots, by job. Leave a slot blank to keep the compiled default
# (see `core/src/provider.rs::model_id`). Use full OpenRouter ids, e.g.
# `anthropic/claude-sonnet-5`, `deepseek/deepseek-chat`, `openai/gpt-5.6-sol`.
# Check `cli.exe` -> `config` to see what actually resolved.
#
#   LUNA   skim      cheapest; summarise, classify, triage           rank 1
#   TERRA  routine   the default workhorse for desk tasks            rank 2
#   SOL    code      code and structured/tool-heavy work             rank 3
#   ASTRA  deep      deep reasoning + the vision fallback path       rank 4
SYN_MODEL_LUNA=
SYN_MODEL_TERRA=
SYN_MODEL_SOL=
SYN_MODEL_ASTRA=

# --- live Office testbed --------------------------------------------------
# Where the COM sidecar reads/writes test documents. Kept inside the repo and
# gitignored so a live run never touches your real files.
SYN_TESTBED=testbed

# Named pipe the C# sidecar listens on (one per app).
SYN_PIPE_EXCEL=synhand-excel
SYN_PIPE_WORD=synhand-word
SYN_PIPE_PPT=synhand-powerpoint
