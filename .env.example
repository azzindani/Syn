# Syn configuration — copy to `.env` and fill in. `.env` is gitignored.
# Every setting is described in docs/configuration.md.
# Real shell exports always win over this file, so a one-off
# `set AGENT_API_KEY=...` overrides the value here without editing it.
# The key is read at send time by the provider only: never logged, never
# written to the journal, never placed in a prompt or an event.
# A key saved in the console's Settings is used before the ones here, and
# lets an installed copy run with no key in this file at all.

# --- provider -------------------------------------------------------------
# OpenRouter key: https://openrouter.ai/keys  (starts sk-or-v1-)
AGENT_API_KEY=

# Endpoint. Any OpenAI-compatible /chat/completions host works.
AGENT_BASE_URL=https://openrouter.ai/api/v1

# Replies are streamed, so a model can think for as long as it needs; a
# connection that sends nothing at all for this many seconds is given up
# on (10-3600). Providers send keep-alives while a model thinks, so this is
# about a dead connection, not a slow model.
AGENT_STREAM_IDLE_SECS=180
# How long an Office call may run before the helper presses Esc at Excel (a
# formula that never finishes calculating), undoes it, and tells the model.
# Opening, exporting, saving and closing get the longer limit (seconds).
AGENT_OFFICE_CALL_SECS=120
AGENT_OFFICE_LONG_SECS=1200
# 0 = wait for whole replies instead (up to five minutes each), for a
# gateway that mishandles "stream": true.
AGENT_STREAM=

# --- more than one provider -----------------------------------------------
# The pair above is the default for every slot. Any slot may override either
# half, and that is what makes the fallback chain worth having: with one
# endpoint for all four slots, a bad minute at the provider is a bad minute
# for every slot at once. A chain whose links share a provider fails as one
# link.
#
# Any OpenAI-compatible host needs nothing but these two lines: Groq,
# DeepInfra, Cerebras, Together, Fireworks, OpenAI itself, or a local
# llama.cpp / Ollama / LM Studio on 127.0.0.1. Providers with their own wire
# format (Anthropic /v1/messages, Google generateContent) are not supported
# yet -- they need a body and a parser of their own.
#
#   AGENT_BASE_URL_CODING=https://api.groq.com/openai/v1
#   AGENT_API_KEY_CODING=gsk_...
#   AGENT_BASE_URL_SMALL=http://127.0.0.1:11434/v1
#   AGENT_API_KEY_SMALL=ollama
AGENT_BASE_URL_SMALL=
AGENT_API_KEY_SMALL=
AGENT_BASE_URL_STANDARD=
AGENT_API_KEY_STANDARD=
AGENT_BASE_URL_CODING=
AGENT_API_KEY_CODING=
AGENT_BASE_URL_REASONING=
AGENT_API_KEY_REASONING=

# --- the console's model picker --------------------------------------------
# The picker lists what the provider in AGENT_BASE_URL serves (its own
# GET /models, refreshed every 15 minutes), and beside it OpenRouter,
# OpenCode Zen and OpenCode Go, whose catalogs are public. A provider with
# no key here still shows its models, marked as needing one; the key is
# what lets a turn be sent to them.
#   OpenCode Zen: https://opencode.ai/zen  (its models on /chat/completions
#   work; ones it serves only on another wire format will refuse the turn).
#   Its free models run with no key at all; Zen keeps some of them to
#   OpenCode's own app and says so when asked for one.
AGENT_API_KEY_OPENCODE=
#   OpenCode Go: https://opencode.ai/go  (the monthly subscription; its own
#   key, a Zen key does not open it; same caveat on wire formats)
AGENT_API_KEY_OPENCODE_GO=
#   OpenRouter, when AGENT_BASE_URL points somewhere else:
AGENT_API_KEY_OPENROUTER=

# --- model selection ------------------------------------------------------
# Four router slots, by job. Leave a slot blank to keep the compiled default
# (`openrouter/auto` for every slot, see `core/src/provider.rs`). Use full
# OpenRouter ids of the form `vendor/model`.
# Give the slots different models if you want a failover chain: slots that
# resolve to the same id are skipped when one fails.
# Check `cli.exe` -> `config` to see what actually resolved.
#
#   SMALL   skim      cheapest; summarise, classify, triage           rank 1
#   STANDARD  routine   the default workhorse for desk tasks            rank 2
#   CODING    code      code and structured/tool-heavy work             rank 3
#   REASONING  deep      deep reasoning + the vision fallback path       rank 4
AGENT_MODEL_SMALL=
AGENT_MODEL_STANDARD=
AGENT_MODEL_CODING=
AGENT_MODEL_REASONING=

# --- the applications ------------------------------------------------------
# Named pipe each sidecar listens on. The console attaches any that is
# running before every turn, and starts the one a task needs. The three
# Office names below are also the defaults when a line is missing or blank;
# set one to off to stop offering that application.
AGENT_PIPE_EXCEL=hand-excel
AGENT_PIPE_WORD=hand-word
AGENT_PIPE_PPT=hand-powerpoint

# The UI Automation sidecar (uia-host), for native windows with no API.
# No default: native windows are offered only when this is set.
AGENT_PIPE_UIA=hand-uia

# Where a Chromium listens with --remote-debugging-port. Covers browsers and
# every Electron app. Loopback only: the port is unauthenticated.
AGENT_CDP=127.0.0.1:9222

# --- the MCP server (mcpgate) -----------------------------------------------
# What an outside model may do through MCP. See docs/mcp.md.
#
# Only these apps (excel, word, powerpoint, browser, window). Blank = all.
# Checked before anything starts; a name that is not an app allows nothing.
AGENT_MCP_APPS=
# Only open files under these folders, and export only into them, separated
# by ';'. Blank = anywhere.
#   AGENT_MCP_ROOTS=C:\Users\me\Documents;D:\work
AGENT_MCP_ROOTS=
# 0 = never start a helper; connect only to ones already running.
AGENT_MCP_LAUNCH=
# Where the helpers are, when not in this repository's own files. On Windows
# office-host.exe and uia-host.exe; elsewhere AGENT_OFFICE_HOST is
# sidecar-lo/lo_host.py, the LibreOffice helper (sidecar-lo/README.md).
AGENT_OFFICE_HOST=
AGENT_UIA_HOST=
# The Python that has LibreOffice's bridge (python3-uno), for lo_host.py.
AGENT_PYTHON=
# 1 = show the LibreOffice windows instead of running headless (needs a display).
AGENT_LO_VISIBLE=

# --- safety switches ----------------------------------------------------------
# 1 = allow `struct` `macro` (write and run VBA in Excel) for processes started
# with it. Off by default: VBA runs with your full privileges. Excel must also
# have Trust access to the VBA project object model turned on.
AGENT_VBA=

# --- tuning (defaults shown; leave blank to keep them) ------------------------
# Tool calls the agent may make in one turn.
#   AGENT_MAX_STEPS=100
# Where Syn keeps chats, live logs and the model cache (default: .agent here).
#   AGENT_HOME=
# 1 = helpers trace every call to stderr.
#   AGENT_TRACE=
# 0 = the console never starts a helper; it only attaches ones already
# running. (The MCP server's own switch is AGENT_MCP_LAUNCH, above.)
#   AGENT_LAUNCH=
