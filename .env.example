# Desktop Agent deployment config — copy to `.env` and fill in. `.env` is gitignored.
# Real shell exports always win over this file, so a one-off
# `set AGENT_API_KEY=...` overrides the value here without editing it.
# The key is read at send time by the provider only: never logged, never
# written to the journal, never placed in a prompt or an event.

# --- provider -------------------------------------------------------------
# OpenRouter key: https://openrouter.ai/keys  (starts sk-or-v1-)
AGENT_API_KEY=

# Endpoint. Any OpenAI-compatible /chat/completions host works.
AGENT_BASE_URL=https://openrouter.ai/api/v1

# --- more than one provider -----------------------------------------------
# The pair above is the default for every slot. Any slot may override either
# half, and that is what makes the fallback chain worth having: with one
# endpoint for all four slots, a bad minute at the provider is a bad minute
# for every slot at once. A run once walked four models -- nemotron, ling,
# qwen (rate-limited), deepseek -- and died anyway, because all four were
# the same provider. A chain whose links share a failure mode is one link.
#
# Any OpenAI-compatible host needs nothing but these two lines: Groq,
# DeepInfra, Cerebras, Together, Fireworks, OpenAI itself, or a local
# llama.cpp / Ollama / LM Studio on 127.0.0.1. Providers with their own wire
# format (Anthropic /v1/messages, Google generateContent) are not supported
# yet -- they need a body and a parser of their own.
#
#   AGENT_BASE_URL_CODING=https://api.groq.com/openai/v1
#   AGENT_API_KEY_CODING=gsk_...
#   AGENT_BASE_URL_SMALL=http://127.0.0.1:11434/v1
#   AGENT_API_KEY_SMALL=ollama
AGENT_BASE_URL_SMALL=
AGENT_API_KEY_SMALL=
AGENT_BASE_URL_STANDARD=
AGENT_API_KEY_STANDARD=
AGENT_BASE_URL_CODING=
AGENT_API_KEY_CODING=
AGENT_BASE_URL_REASONING=
AGENT_API_KEY_REASONING=

# --- model selection ------------------------------------------------------
# Four router slots, by job. Leave a slot blank to keep the compiled default
# (see `core/src/provider.rs::model_id`). Use full OpenRouter ids, e.g.
# `anthropic/claude-sonnet-5`, `deepseek/deepseek-chat`, `openai/gpt-5.6-sol` (a vendor id, unrelated to the slot names).
# Check `cli.exe` -> `config` to see what actually resolved.
#
#   SMALL   skim      cheapest; summarise, classify, triage           rank 1
#   STANDARD  routine   the default workhorse for desk tasks            rank 2
#   CODING    code      code and structured/tool-heavy work             rank 3
#   REASONING  deep      deep reasoning + the vision fallback path       rank 4
AGENT_MODEL_SMALL=
AGENT_MODEL_STANDARD=
AGENT_MODEL_CODING=
AGENT_MODEL_REASONING=

# --- live Office testbed --------------------------------------------------
# Where the COM sidecar reads/writes test documents. Kept inside the repo and
# gitignored so a live run never touches your real files.
AGENT_TESTBED=testbed

# Named pipe each sidecar listens on. These drive the "Connect a hand"
# buttons in the app: a blank entry means that hand is simply not offered,
# because a button that cannot work is worse than no button.
AGENT_PIPE_EXCEL=hand-excel
AGENT_PIPE_WORD=hand-word
AGENT_PIPE_PPT=hand-powerpoint

# The UI Automation sidecar (uia-host), for native windows with no API.
AGENT_PIPE_UIA=hand-uia

# Where a Chromium listens with --remote-debugging-port. Covers browsers and
# every Electron app. Loopback only: the port is unauthenticated.
AGENT_CDP=127.0.0.1:9222
